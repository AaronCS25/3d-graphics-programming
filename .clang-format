# Consistent formatting for the whole repo. Run: clang-format -i src/*.cpp
BasedOnStyle: LLVM
IndentWidth: 4
ColumnLimit: 100
AllowShortFunctionsOnASingleLine: Empty
BreakBeforeBraces: Attach
PointerAlignment: Left

# glad must be included before GLFW: glad.h aborts with #error if a GL header
# was pulled in first. Pin the order so sorting on save cannot break the build.
IncludeBlocks: Preserve
IncludeCategories:
  - Regex: '^<glad/'
    Priority: 1
  - Regex: '^<GLFW/'
    Priority: 2
  - Regex: '^<'
    Priority: 3
  - Regex: '.*'
    Priority: 4
